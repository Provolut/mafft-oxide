#!/bin/bash
# Refuse a push whose tests fail or whose coverage has dropped below the floor,
# and refresh the sampling profile on the way through.
#
# Install once:
#     git config core.hooksPath .githooks
#
# About 25 seconds without a recorded golden store, and about 1m50s with one:
# the encoding check is instant, the release test suite ~1.5 s warm, coverage
# 16 s, the sampling profile a few more, and the replayed differentials 1m21s.
# That is deliberate -- a hook slow enough to be worth skipping gets skipped,
# and then it is not a gate. `--no-verify` bypasses it when you genuinely need
# to push a work-in-progress branch.
#
# Two things this does NOT do, on purpose:
#
#  * It does not gate on a full differential against a compiled `core/`. It
#    does run one when a recorded store is present -- see below -- but it will
#    not sit for the 2m51s that running the C itself costs.
#  * It does not gate on performance. The profiling database is measured with
#    callgrind, which costs ~50x, and wall-clock numbers taken on a machine
#    busy with a push are not comparable to anything. `bench/sample.sh`
#    refreshes a cheap sampling profile instead, and only warns.

set -u
here=$(cd "$(dirname "$0")/.." && pwd)

# Deleting a remote branch is a push, so this hook runs for it -- and it has
# nothing to say about a ref that is going away. That was merely silly while the
# hook took 25 seconds; now that it replays two differentials it is a hundred,
# and a `git push --delete` that sits for two minutes is how people learn to
# reach for --no-verify.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per update on
# stdin, and a deletion has an all-zero local sha. Only skip when every update
# in the push is one: a push that both deletes and adds still gets checked. Run
# by hand there is no stdin to read, and `read` would block on the terminal, so
# that case falls through and does everything.
if [ ! -t 0 ]; then
  saw=0
  live=0
  while read -r _lref lsha _rref _rsha; do
    saw=1
    case "$lsha" in
      *[!0]*) live=1 ;;
    esac
  done
  if [ "$saw" = 1 ] && [ "$live" = 0 ]; then
    echo "pre-push: deleting refs only, nothing to check"
    exit 0
  fi
fi

# Cheap and first: a source file that is not UTF-8 is invisible to grep in a
# UTF-8 locale -- no match, no count, no warning -- so "nothing calls this"
# stops being a safe conclusion. Upstream ships eight such files; see
# scripts/check-encoding.sh.
if ! "$here/scripts/check-encoding.sh" > /dev/null; then
  "$here/scripts/check-encoding.sh" 1>&2
  echo "pre-push: push refused. Use --no-verify to override." 1>&2
  exit 1
fi

cd "$here/rust" || exit 0   # nothing to check if the port is not present

FLOOR=89
fail() { echo; echo "pre-push: $*" 1>&2; echo "pre-push: push refused. Use --no-verify to override." 1>&2; exit 1; }

echo "pre-push: cargo test"
if ! cargo test --release --quiet 2>&1 | tail -20; then
  fail "tests failed"
fi
# `cargo test --quiet` exits non-zero on failure, but the pipe above swallows
# it; PIPESTATUS is what actually happened.
[ "${PIPESTATUS[0]:-0}" -eq 0 ] || fail "tests failed"

echo "pre-push: coverage (this is the slow part)"
cov_out=$(./bench/coverage.sh 2>/dev/null) || fail "coverage run failed"
total=$(printf '%s\n' "$cov_out" | awk '$1=="TOTAL"{print $3}' | tr -d '%')
if [ -z "$total" ]; then
  fail "could not parse coverage output -- has bench/coverage.sh changed?"
fi
if awk -v t="$total" -v f="$FLOOR" 'BEGIN{ exit !(t < f) }'; then
  printf '%s\n' "$cov_out" | grep -E '^src|^TOTAL' 1>&2
  fail "region coverage ${total}% is below the ${FLOOR}% floor"
fi
echo "pre-push: coverage ${total}% (floor ${FLOOR}%)"

# Profiling runs on every push because it is cheap enough to: gprofng samples
# at about 4% here, and `sample.sh` measures that per case rather than assuming
# it. Over budget is a warning, not a block -- a distorted profile is a reason
# to distrust the profile, not to reject the code.
echo "pre-push: sampling profile"
if ! ./bench/sample.sh 8 > /tmp/pre-push-sample.$$ 2>&1; then
  echo "pre-push: WARNING -- the sampling profiler exceeded its 8% budget;" 1>&2
  echo "          the profile was discarded. See bench/sample-profile.txt." 1>&2
fi
grep -E '^== ' /tmp/pre-push-sample.$$ 2>/dev/null | sed 's/^/  /'
rm -f /tmp/pre-push-sample.$$

# The differentials, and why they are here at all.
#
# This hook once passed a push that moved every harness into `verify/` and left
# their paths resolving one directory too high -- every one of them broken, and
# nothing noticed, because `cargo test` does not run shell scripts. The harness
# tallies quoted in that commit message were true of the working tree and not of
# the commit. So the harnesses run here now.
#
# Two things happen, and the cheap one always happens. Asking a harness to emit
# its corpus makes it resolve `gencorpus.py`, `test/sample` and the binaries --
# every path the move broke -- for about a second and with no C on the machine.
# That is the regression guard.
#
# The full differential then runs only if a recorded store is there to replay
# (`verify_golden.sh`, 1m21s for both, still no C). Without one this says so
# rather than quietly reducing to the smoke test, and rather than spending 2m51s
# running the C -- a hook that surprises you with three minutes is a hook people
# stop using, and then it is not a gate.
echo "pre-push: harness paths"
for h in verify.sh verify_tbfast.sh; do
  case "$h" in
    verify.sh) rs="target/release/disttbfast-rs"; store="tests/golden/disttbfast.tar.gz" ;;
    *)         rs="target/release/tbfast-rs";     store="tests/golden/tbfast.tar.gz" ;;
  esac
  d=$(mktemp -d)
  # Both binaries are the port's own: this is not a comparison, it is a check
  # that the harness can find what it needs.
  if ! VERIFY_EMIT_CORPUS="$d/c" "./verify/$h" "$rs" "$rs" > "$d/log" 2>&1; then
    sed 's/^/  /' "$d/log" 1>&2
    rm -rf "$d"
    fail "$h cannot resolve its own inputs"
  fi
  n=$(find "$d/c" -maxdepth 1 -type f 2>/dev/null | wc -l)
  rm -rf "$d"
  [ "$n" -ge 10 ] || fail "$h produced a corpus of $n files"
  echo "  == $h: resolves, corpus of $n files"
done

ran=0
for h in verify.sh verify_tbfast.sh; do
  case "$h" in
    verify.sh) rs="target/release/disttbfast-rs"; store="tests/golden/disttbfast.tar.gz" ;;
    *)         rs="target/release/tbfast-rs";     store="tests/golden/tbfast.tar.gz" ;;
  esac
  [ -f "$store" ] || continue
  ran=1
  echo "pre-push: $h replayed against $store"
  out=$(./verify/verify_golden.sh replay "$h" "$store" "$rs" 2>&1) || {
    printf '%s\n' "$out" | tail -20 1>&2
    fail "$h differs from the recorded C"
  }
  printf '%s\n' "$out" | grep -E '^pass=' | sed 's/^/  == /'
done
if [ "$ran" = 0 ]; then
  echo "  == no recorded store; the full differential did not run. To add one:"
  echo "     rust/verify/verify_golden.sh record verify.sh core/disttbfast \\"
  echo "         rust/target/release/disttbfast-rs rust/tests/golden/disttbfast.tar.gz"
fi

echo "pre-push: ok"
